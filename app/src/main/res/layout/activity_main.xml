<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zemin"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        style="@style/Etiket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bölüm" />

    <!-- Bolumler: yeni bolum icin buraya Button eklemek ve Tasarim.bolumRengi()'ne renk vermek yeterli
         (butonun yazisi kayda gecer) -->
    <LinearLayout
        android:id="@+id/bolumGrubu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bolumCnc"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="CNC"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/bolumFreze"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Freze"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/bolumKesme"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Kesme"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/bolumOfis"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Ofis"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bolumElektrik"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Elektrik"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/bolum3d"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="3D Baskı"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/bolumSonKontrol"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="Son Kontrol"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ana islem: secili bolumun renginde -->
    <Button
        android:id="@+id/btnTara"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        style="@style/Etiket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Elle giriş / el okuyucu" />

    <LinearLayout
        android:id="@+id/elleKutu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/elleGiris"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Barkod numarası"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/metin"
            android:textColorHint="@color/soluk"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnKaydet"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="Kaydet"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPaylas"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="Dosyayı paylaş"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSonuSil"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="Son kaydı sil"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Kayit dosyasi: secilmezse otomatik dosya, secilirse o dosyaya devam -->
    <TextView
        style="@style/Etiket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Kayıt dosyası" />

    <TextView
        android:id="@+id/dosyaYolu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/metin"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDosyaSec"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="Dosya seç"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnYeniDosya"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="Yeni dosya"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOtomatik"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:stateListAnimator="@null"
            android:text="Otomatik"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Etiket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Son kayıtlar" />

        <TextView
            android:id="@+id/kayitSayisi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/soluk"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/kayitKutu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:padding="12dp">

        <TextView
            android:id="@+id/kayitlar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/metin"
            android:textSize="13sp" />
    </ScrollView>

</LinearLayout>
